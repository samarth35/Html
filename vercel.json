{
  "version": 2,
  "builds": [
    {
      "src": "jainzee-website/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "jainzee-website/static/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "jainzee-website/static/images/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "jainzee-website/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "jainzee-website/app.py"
    }
  ]
}
